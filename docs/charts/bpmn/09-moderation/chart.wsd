@startuml Moderation_Flow_BPMN

skinparam sequenceMessageAlign center

skinparam activity {
    BackgroundColor White
    BorderColor Black
    BorderThickness 2
    FontName "Arial"
    FontSize 12
}

skinparam title {
    FontSize 18
}

title BPMN: Модерация контента

start

' ============================================
' ПОСТУПЛЕНИЕ ЖАЛОБЫ
' ============================================

:Поступление сигнала о нарушении;
note right: Триггер

switch (Тип триггера)
    case (Жалоба)
        :Регистрация жалобы;
        note left: Подача жалобы\nпользователем
    case (Системное оповещение)
        :Системое оповещение;
        note right: Автоматическая проверка
    case (Плановая прокерка)
        :Ручная проверка контента;
        note right: Админ просматривает\nконтент
endswitch

:Назначение модератора;
note right: UC_Moderate\nНужны права админа

:Просмотр контента;
note right: Шейдер / Комментарий / Профиль

:Анализ на соответствие правилам;
note right: Правила платформы

' ============================================
' РЕШЕНИЕ МОДЕРАТОРА
' ============================================
if (Нарушение подтверждено?) then (Нет)
    :Отклонение жалобы;
    :Уведомление заявителя (опционально);
    :Закрытие случая;
    stop
else (Да)
    switch (Классификация нарушения)
    
    case (Лёгкое)
        :Предупреждение пользователю;
        :Скрытие контента;
    case (Среднее)
        :Удаление контента;
        note right: <<UC_DeleteShader>>\n<<UC_DeleteComment>>
        :Предупреждение пользователю;
        :Запись в историю нарушений;
    case (Тяжёлое)
        :Удаление контента;
        note left: <<UC_DeleteShader>>\n<<UC_DeleteComment>>
        :Проверка истории нарушений;
        
        if (Повторное нарушение?) then (Нет)
            :Временная блокировка;
            note left: Временная\nблокировка
        else (Да)
            :Постоянная блокировка;
            note right: Перманентная\nблокировка
        endif
    case (Критическое)
        :Немедленная блокировка;
        :Эскалация старшему модератору;
        :Сохранение доказательств;
    endswitch
endif

' ============================================
' ДЕЙСТВИЯ НАД КОНТЕНТОМ
' ============================================
fork
if (Требуется удаление шейдера?) then (Да)
    :Удаление шейдера;
    note left: <<UC_DeleteShader>>
    :Уведомление автора;
    :Проверка форков;
    
    if (Есть форки у других?) then (Да)
        :Установить статус проверки\nдля сиротских шейдеров;
        note left: Сохранение целостности:\nфорки остаются,\nно они должны\nбыть проверены
    else (Нет)
    endif
    :Удаление шейдера;
else (Нет)
    :Пропуск удаления шейдера;
endif

fork again
if (Требуется удаление комментария?) then (Да)
    :Удаление комментария;
    note left: <<UC_DeleteComment>>
    :Уведомление автора комментария;
else (Нет)
    :Пропуск удаления комментария;
endif

fork again
if (Требуется блокировка пользователя?) then (Да)
    :Блокировка аккаунта;
    note left: <<UC_BanUser>>
    :Инвалидация всех сессий;
    :Запрет на регистрацию с того же email/IP;
else (Нет)
    :Пропуск блокировки;
endif
end fork

' ============================================
' УВЕДОМЛЕНИЕ ПОЛЬЗОВАТЕЛЯ
' ============================================
:Отправка уведомления о решении;
note right: Email / Внутренняя система оповещения:\n- Причина действия\n- Ссылка на правила сообщества\n- Информация об апелляции

' ============================================
' АПЕЛЛЯЦИЯ (опционально)
' ============================================
if (Пользователь подал апелляцию?) then (Да)
    :Регистрация апелляции;
    :Назначение другого модератора;
    note left: Для объективности
    
    if (Апелляция удовлетворена?) then (Да)
        :Отмена решения;
        :Восстановление контента;
        :Разблокировка пользователя\n(если был забанен);
        note left: <<UC_UnbanUser>>
        :Компенсация (если необходима);
    else (Нет)
        :Подтверждение решения;
        :Закрытие апелляции;
    endif
else (Нет)
    :Пропуск апелляции;
endif

' ============================================
' ФИНАЛИЗАЦИЯ
' ============================================
:Логирование всех действий;
note right:- Кто модерировал\n- Какое решение принято\n- Таймстемпы\n- Доказательства (скриншоты)\n- т. д.

:Обновление статистики модерации;

:Закрытие случая;

stop

@enduml